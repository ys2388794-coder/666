                <div className="w-full max-w-2xl glowing-box bg-black/60 p-6 md:p-10 rounded-3xl relative">
                  <h3 className="text-2xl md:text-3xl font-amiri text-neonpink mb-3 text-center">
                    ✨ أمنيتك إيه السنة دي يا جرجورتي؟
                  </h3>
                  <p className="text-xs md:text-sm text-gray-400 text-center mb-6">
                    الصندوق بيكبر معاكي كل ما تكتبي أكتر.. اكتبي كل اللي بتتمنيه وخديها سكرين وابعتيهالي ❤️
                  </p>
                  <textarea
                    onInput={(e) => {
                      const t = e.currentTarget;
                      t.style.height = "";
                      t.style.height = t.scrollHeight + "px";
                    }}
                    className="w-full bg-red-950/20 border border-pink-800/50 focus:border-neonpink focus:outline-none text-white rounded-2xl p-5 min-h-[140px] resize-none text-base md:text-lg leading-relaxed transition-all"
                    placeholder="اكتبي الي اتمنتيه هنا وخديها اسكرين وابعتيهالي..."
                  />
                </div>
              </section>

              {/* 9. GIFT */}
              <section className="min-h-[70vh] py-20 px-4 bg-darkbg flex flex-col items-center justify-center relative overflow-hidden">
                <h2 className="text-2xl md:text-4xl text-pink-200 mb-4 font-amiri text-center">
                  🎁 هديتك مستنياكي.. اضغطي على الصندوق وهزي التليفون!
                </h2>
                <p className="text-gray-400 text-sm mb-10 text-center">
                  (جواها كريب ودباديب وقطط وشوكولاتات كتير على قدي 😂❤️)
                </p>
                <div
                  onClick={() => setGiftOpen(true)}
                  className="cursor-pointer transition-transform duration-300 hover:scale-110 active:scale-95 animate-bounce"
                >
                  <div className="text-[9rem] md:text-[12rem] drop-shadow-[0_0_30px_rgba(255,20,147,0.6)] select-none">🎁</div>
                </div>
              </section>

              {/* 10. FINAL HEART */}
              <section
                ref={finalRef}
                className="min-h-screen py-20 px-4 bg-black flex flex-col items-center justify-center overflow-hidden relative"
              >
                <div className="text-center relative z-10 px-4 mb-4">
                  <h1 className="text-3xl md:text-6xl font-bold font-amiri text-white animate-happy-birthday">
                    كل سنة وإنتي طيبة يا جرجورتي ❤️
                  </h1>
                  <p className="text-pink-400 mt-3 text-sm md:text-lg">
                    بكل لغات العالم الكلمات بتلف حوالين بعضها عشان ترسم قلب عيد ميلادك
                  </p>
                </div>

                <div className="relative w-[94vw] h-[94vw] max-w-[600px] max-h-[600px] flex items-center justify-center z-10">
                  <WordHeart words={birthdayWordsList} play={finalSeen} className="w-full h-full" />
                </div>

                <div
                  className="mt-4 text-2xl md:text-4xl font-cairo font-bold text-neonpink h-12 transition-opacity duration-500 z-10 text-center"
                  style={{ opacity: langVisible ? 1 : 0 }}
                >
                  {birthdayWordsList[langIdx]} ❤️
                </div>
              </section>

              <footer className="bg-black py-8 text-center border-t border-red-950/60 relative z-10">
                <p className="text-xs md:text-sm text-pink-500 font-amiri font-bold tracking-wider">
                  صنع بحب من كتكوتك أوفص ❤️
                </p>
              </footer>
            </main>

            <GiftModal open={giftOpen} onClose={() => setGiftOpen(false)} />
          </div>
        );
      }

      const root = ReactDOM.createRoot(document.getElementById("root"));
      root.render(<App />);
    </script>
  </body>
</html>
