      /* ---------------- CAKE ---------------- */
      function Cake() {
        const TOTAL = 19;
        const [blown, setBlown] = useState(new Set());
        const promiseRef = useRef(null);
        const timers = useRef([]);
        const allDone = blown.size === TOTAL;

        const blow = (n) =>
          setBlown((prev) => {
            if (prev.has(n)) return prev;
            const next = new Set(prev);
            next.add(n);
            return next;
          });

        const blowAll = () => {
          for (let n = 1; n <= TOTAL; n++) {
            timers.current.push(window.setTimeout(() => blow(n), (n - 1) * 90));
          }
        };

        useEffect(() => {
          if (!allDone) return;
          const t = window.setTimeout(
            () => promiseRef.current?.scrollIntoView({ behavior: "smooth", block: "center" }),
            500
          );
          return () => clearTimeout(t);
        }, [allDone]);

        useEffect(() => () => timers.current.forEach(clearTimeout), []);

