      /* ---------------- WORD HEART LOGIC ---------------- */
      const WORD_COLOR = "#ff6b88";
      const FONT_FAMILY = "Cairo, sans-serif";
      const FONT_WEIGHT = 700;
      const FONT_SIZE = 11.5;
      const CX = 325;
      const CY = 300;
      const GAP = 7;
      const PAD = 1.5;

      function heartPoint(t, scale) {
        const x = CX + scale * (16 * Math.pow(Math.sin(t), 3));
        const y = CY - scale * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
        return { x, y };
      }

      function sampleHeart(scale, n = 900) {
        const pts = [];
        let total = 0;
        for (let i = 0; i <= n; i++) {
          const p = heartPoint((i / n) * Math.PI * 2, scale);
          if (i > 0) total += Math.hypot(p.x - pts[i - 1].x, p.y - pts[i - 1].y);
          pts.push({ x: p.x, y: p.y, s: total });
        }
        return { pts, total };
      }

      function atArc(sampled, target) {
        const { pts, total } = sampled;
        const s = ((target % total) + total) % total;
        let lo = 0, hi = pts.length - 1;
        while (lo < hi) {
          const mid = (lo + hi) >> 1;
          if (pts[mid].s < s) lo = mid + 1;
          else hi = mid;
        }
        const idx = Math.max(2, Math.min(lo, pts.length - 3));
        const a = pts[idx - 2];
        const b = pts[idx + 2];
        let angle = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
        if (angle > 90) angle -= 180;
        if (angle < -90) angle += 180;
        return { x: pts[idx].x, y: pts[idx].y, angle };
      }

      function corners(r) {
        const c = Math.cos(r.a);
        const s = Math.sin(r.a);
        const hw = r.w / 2;
        const hh = r.h / 2;
        return [
          [-hw, -hh], [hw, -hh], [hw, hh], [-hw, hh]
        ].map(([dx, dy]) => ({ x: r.cx + dx * c - dy * s, y: r.cy + dx * s + dy * c }));
      }

      function overlap(a, b) {
        if (Math.hypot(a.cx - b.cx, a.cy - b.cy) > (a.w + b.w + a.h + b.h) / 2) return false;
        const ca = corners(a);
        const cb = corners(b);
        for (const poly of [ca, cb]) {
          for (let i = 0; i < 4; i++) {
            const p1 = poly[i];
            const p2 = poly[(i + 1) % 4];
            const nx = p2.y - p1.y;
            const ny = p1.x - p2.x;
            let minA = Infinity, maxA = -Infinity, minB = Infinity, maxB = -Infinity;
            for (const p of ca) {
              const d = p.x * nx + p.y * ny;
              minA = Math.min(minA, d); maxA = Math.max(maxA, d);
            }
            for (const p of cb) {
              const d = p.x * nx + p.y * ny;
              minB = Math.min(minB, d); maxB = Math.max(maxB, d);
            }
            if (maxA < minB || maxB < minA) return false;
          }
        }
        return true;
      }

      function layoutWords(words) {
        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d");
        ctx.font = `${FONT_WEIGHT} ${FONT_SIZE}px ${FONT_FAMILY}`;

        const placed = [];
        const rects = [];
        let counter = 0;

        const rings = [];
        for (let sc = 3.4; sc <= 15.9; sc += 1.55) rings.push(sc);
        const h = FONT_SIZE * 1.2 + PAD * 2;

        rings.forEach((scale) => {
          const sampled = sampleHeart(scale);
          const perimeter = sampled.total;
          let cursor = 10;

          while (cursor < perimeter - 14) {
            const text = words[counter % words.length];
            const w = ctx.measureText(text).width + PAD * 2;
            if (cursor + w > perimeter - 8) break;

            const pos = atArc(sampled, cursor + w / 2);
            const rect = { cx: pos.x, cy: pos.y, w, h, a: (pos.angle * Math.PI) / 180 };

            if (rects.some((r) => overlap(rect, r))) {
              cursor += 3;
              continue;
            }

            rects.push(rect);
            placed.push({ text, x: pos.x, y: pos.y, angle: pos.angle });
            counter++;
            cursor += w + GAP;
          }
        });

        return placed;
      }

      function WordHeart({ words, play, step = 26, className = "" }) {
        const [placed, setPlaced] = useState([]);

        useEffect(() => {
          let cancelled = false;
          const build = () => {
            if (!cancelled) setPlaced(layoutWords(words));
          };
          const fontSpec = `${FONT_WEIGHT} ${FONT_SIZE}px Cairo`;
          const sample = words.join(" ");
          const timeout = new Promise((r) => setTimeout(r, 2500));
          const load = document.fonts
            ? document.fonts.load(fontSpec, sample).then(() => document.fonts.ready).then(() => undefined)
