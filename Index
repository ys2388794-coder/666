          if (!open) return;
          const move = (fn) => {
            containerRef.current?.querySelectorAll(".liquid-emoji").forEach((el) => {
              el.style.transform = fn(parseFloat(el.dataset.speed || "1"));
            });
          };
          const onOrient = (ev) => {
            const x = ev.gamma || 0;
            const y = Math.max(-90, Math.min(90, ev.beta || 0));
            move((s) => `translate(${x * s * 1.6}px, ${y * s * 1.6}px)`);
          };
          const onMouse = (ev) => {
            const cx = window.innerWidth / 2;
            const cy = window.innerHeight / 2;
            const x = ((ev.clientX - cx) / cx) * 50;
            const y = ((ev.clientY - cy) / cy) * 50;
            move((s) => `translate(${x * s * 1.4}px, ${y * s * 1.4}px)`);
          };

          const DOE = window.DeviceOrientationEvent;
          if (DOE && typeof DOE.requestPermission === "function") {
            DOE.requestPermission()
              .then((st) => st === "granted" && window.addEventListener("deviceorientation", onOrient))
              .catch(() => undefined);
          } else {
            window.addEventListener("deviceorientation", onOrient);
          }
          window.addEventListener("mousemove", onMouse);
          return () => {
            window.removeEventListener("deviceorientation", onOrient);
            window.removeEventListener("mousemove", onMouse);
