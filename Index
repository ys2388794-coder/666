          Promise.race([load.catch(() => undefined), timeout]).then(build);
          return () => { cancelled = true; };
        }, [words]);

        const centerPath = useMemo(() => {
          const pts = [];
          for (let i = 0; i <= 100; i++) {
            const p = heartPoint((i / 100) * Math.PI * 2, 1.65);
            pts.push(`${i === 0 ? "M" : "L"} ${p.x.toFixed(1)},${p.y.toFixed(1)}`);
          }
          return pts.join(" ") + " Z";
        }, []);

